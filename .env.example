# ============================================================
#  환경설정 예시 (.env.example)
#  이 파일을 복사해서 .env 로 만든 뒤, Claude 키만 채우면 됩니다.
#    Windows: Copy-Item .env.example .env
#  실제 키가 담긴 .env 는 커밋되지 않습니다(.gitignore 처리됨).
# ============================================================

# ▼ Claude(Anthropic) API 키 — 영역 추출(비전 OCR/LaTeX) 기능에 필요합니다.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ------------------------------------------------------------
#  아래는 선택 항목입니다(기본값으로 동작).
# ------------------------------------------------------------

# Claude 비전 모델명 (미설정 시 기본값: claude-3-5-sonnet-latest)
# CLAUDE_VISION_MODEL=claude-3-5-sonnet-latest

# ANTHROPIC_API_KEY의 폴백. ANTHROPIC_API_KEY가 있으면 그쪽이 우선합니다.
# CLAUDE_API_KEY=your-claude-api-key-here

# Gemini 페이지 crop 검토/재탐지(auto 재처리)에 필요합니다.
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_CROP_MODEL=gemini-3.1-flash-lite

# 기존 분석/생성 기능용 OpenAI 키 (영역 추출에는 불필요)
# OPENAI_API_KEY=your-openai-api-key-here

# DB 연결 문자열 (미설정 시 로컬 SQLite 파일 사용)
# DATABASE_URL=sqlite:///./math_problem_engine.db

# 디버그 로그 (true/false)
# DEBUG=False
